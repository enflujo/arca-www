{
  "name": "arca-www",
  "packageManager": "yarn@4.12.0",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write --list-different .",
    "serve": "yarn server:start",
    "stop": "yarn server:stop",
    "restart": "yarn server:restart",
    "server:start": "yarn build && pm2 start ecosystem.config.js",
    "server:stop": "pm2 stop ecosystem.config.js",
    "server:restart": "pm2 restart ecosystem.config.js"
  },
  "dependencies": {
    "@enflujo/alquimia": "^2.0.0",
    "@meilisearch/instant-meilisearch": "^0.29.0",
    "@pinia/nuxt": "^0.11.3",
    "html-to-text": "^9.0.5",
    "mapbox-gl": "^3.17.0",
    "nuxt": "^4.2.2",
    "pinia": "^3.0.4",
    "vue-instantsearch": "^4.22.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/html-to-text": "^9.0.4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^25.0.3",
    "prettier": "^3.7.4",
    "sass": "^1.97.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
